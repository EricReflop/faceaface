---
import logo from '../assets/logo.svg';
import iconeFermer from '../assets/icons/x.svg';
import Reseaux from './Reseaux.astro';
import { menuPrincipal, estActif } from '../lib/navigation';

const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap barre">
    <a class="logo" href="/">
      <img src={logo.src} width="138" height="84" alt="Face à Face, accueil" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span>Menu</span>
      <svg class="icone-ouvrir" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M3.333 5.833h13.334M3.333 10h13.334M3.333 14.167h13.334" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <img class="icone-fermer" src={iconeFermer.src} width="20" height="20" alt="" />
    </button>

    <div id="menu-principal" class="menu">
      <nav aria-label="Navigation principale">
        <ul class="liens">
          {menuPrincipal.map((l) => (
            <li><a href={l.href} aria-current={estActif(path, l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <Reseaux />
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('menu-principal');
  btn?.addEventListener('click', () => {
    const ouvert = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!ouvert));
    menu?.classList.toggle('is-open', !ouvert);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      btn.click();
      btn.focus();
    }
  });
</script>

<style>
  .site-header { background: var(--fond-marque-charbon); color: var(--texte-marque-blanc); }
  .barre { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; min-height: 92px; }
  .logo { display: block; }
  .logo img { width: 112px; height: auto; }

  /* Bouton du menu compact (Figma : Commande du menu) */
  .menu-toggle {
    display: inline-flex; align-items: center; gap: var(--espacement-10);
    min-height: var(--tap); padding: 0; background: none; border: 0; color: inherit; cursor: pointer;
    font: 600 var(--taille-12) / 1 var(--famille-texte);
  }
  .icone-fermer, [aria-expanded='true'] .icone-ouvrir { display: none; }
  [aria-expanded='true'] .icone-fermer { display: block; }

  /* Menu compact déplié : liens sur 2 colonnes + réseaux */
  /* Sans JavaScript, le menu reste visible ; avec JS il est replié par défaut. */
  .menu { display: flex; width: 100%; flex-direction: column; gap: var(--espacement-22); padding: var(--espacement-12) 0 var(--espacement-24); }
  :global(html.js) .menu:not(.is-open) { display: none; }
  :global(html:not(.js)) .menu-toggle { display: none; }
  .liens { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--espacement-14); list-style: none; margin: 0; padding: 0; }
  .liens a {
    display: flex; align-items: center; min-height: var(--tap);
    color: var(--texte-marque-blanc); text-decoration: none;
    font: 600 var(--taille-12) / 1 var(--famille-texte);
  }
  .liens a[aria-current='page'] { text-decoration: underline; text-underline-position: from-font; }
  .liens a:hover { text-decoration: underline; }
  .menu :global(.reseaux) { margin-left: -6px; }

  @media (min-width: 64rem) {
    .barre { flex-wrap: nowrap; min-height: 112px; }
    .logo img { width: 138px; }
    .menu-toggle { display: none; }
    .menu, :global(html.js) .menu:not(.is-open) { display: contents; }
    .liens { display: flex; gap: var(--espacement-24); }
    .liens a { min-height: 32px; font-weight: 500; white-space: nowrap; }
    .liens a[aria-current='page'] { font-weight: 700; }
    .menu :global(.reseaux) { margin: 0 -6px 0 0; }
  }
</style>
