---
import site from '../data/site.json';

const liens = [
  { href: '/cours-horaires/', label: 'Cours & horaires' },
  { href: '/cours-essai/', label: 'Essai gratuit' },
  { href: '/inscription/', label: 'Inscription & tarifs' },
  { href: '/le-club/', label: 'Le club' },
  { href: '/le-muay-thai/', label: 'Le Muay Thaï' },
  { href: '/actualites/', label: 'Actualités' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const actif = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${site.nom}, accueil`}>
      <!-- Remplacer par le logo SVG final -->
      <span aria-hidden="true">FACE <b>À</b> FACE</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="visually-hidden">Ouvrir le menu</span>
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2"></path></svg>
    </button>
    <nav id="menu-principal" aria-label="Navigation principale">
      <ul>
        {liens.map((l) => (
          <li><a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('menu-principal');
  const label = btn?.querySelector('.visually-hidden');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (label) label.textContent = open ? 'Ouvrir le menu' : 'Fermer le menu';
    nav?.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      btn.click();
      btn.focus();
    }
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--color-surface-inverse); color: var(--color-on-inverse); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 4rem; }
  .logo { color: inherit; text-decoration: none; font-family: var(--font-display); font-size: var(--text-xl); letter-spacing: 0.04em; }
  .logo b { color: var(--color-brand); font-weight: 400; background: var(--color-on-inverse); padding-inline: 0.15em; }
  .menu-toggle { display: inline-grid; place-items: center; width: var(--tap); height: var(--tap); background: none; border: 0; color: inherit; cursor: pointer; }
  nav { display: none; position: absolute; inset: 100% 0 auto; background: var(--color-surface-inverse); padding: var(--space-4); }
  nav.is-open { display: block; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  nav a { display: flex; align-items: center; min-height: var(--tap); padding-inline: var(--space-2); color: var(--color-on-inverse); text-decoration: none; font-weight: 600; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-brand); text-decoration-thickness: 3px; }
  @media (min-width: 64rem) {
    .menu-toggle { display: none; }
    nav { display: block; position: static; padding: 0; background: none; }
    ul { display: flex; gap: var(--space-4); }
  }
</style>
