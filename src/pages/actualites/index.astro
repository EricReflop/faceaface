---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import site from '../../data/site.json';
import { breadcrumbs } from '../../lib/schema';
import { dateLongue } from '../../lib/format';

const fil = [{ name: 'Actualités', path: '/actualites/' }];
const actus = (await getCollection('actus', ({ data }) => !data.brouillon)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---
<Base
  title="Actualités du club de boxe thaï"
  description="Cours d’essai, compétitions, galas et vie du club : toutes les actualités de Face à Face, club de Muay Thaï à Reims."
  jsonLd={breadcrumbs(fil)}
>
  <Breadcrumbs items={fil} />
  <PageHeader titre="Actualités" intro="La vie du club : cours d’essai, compétitions, stages et résultats." />

  <section class="section">
    <div class="container">
      <ul class="liste">
        {actus.map((a) => (
          <li class="card">
            <h2><a href={`/actualites/${a.id}/`}>{a.data.titre}</a></h2>
            <p><time datetime={a.data.date.toISOString()}>{dateLongue(a.data.date)}</time></p>
            <p>{a.data.description}</p>
          </li>
        ))}
      </ul>
      <p>Suivez aussi le club sur <a href={site.reseaux.instagram} rel="noopener">Instagram</a> et <a href={site.reseaux.facebook} rel="noopener">Facebook</a>.</p>
    </div>
  </section>
</Base>

<style>
  .liste { list-style: none; padding: 0; display: grid; gap: var(--space-6); }
  .liste h2 { font-size: var(--text-xl); text-transform: none; }
</style>
