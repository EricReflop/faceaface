---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaEssai from '../../components/CtaEssai.astro';
import { breadcrumbs, orgRef } from '../../lib/schema';
import { dateLongue } from '../../lib/format';

export async function getStaticPaths() {
  const actus = await getCollection('actus', ({ data }) => !data.brouillon);
  return actus.map((actu) => ({ params: { slug: actu.id }, props: { actu } }));
}

const { actu } = Astro.props;
const { Content } = await render(actu);
const path = `/actualites/${actu.id}/`;
const fil = [
  { name: 'Actualités', path: '/actualites/' },
  { name: actu.data.titre, path },
];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: actu.data.titre,
  description: actu.data.description,
  datePublished: actu.data.date.toISOString(),
  inLanguage: 'fr-FR',
  author: orgRef,
  publisher: orgRef,
  mainEntityOfPage: new URL(path, Astro.site).href,
};
---
<Base title={actu.data.titre} description={actu.data.description} ogType="article" jsonLd={[breadcrumbs(fil), articleLd]}>
  <Breadcrumbs items={fil} />
  <article class="section">
    <div class="container prose">
      <header>
        <h1>{actu.data.titre}</h1>
        <p><time datetime={actu.data.date.toISOString()}>{dateLongue(actu.data.date)}</time></p>
      </header>
      <Content />
    </div>
  </article>
  <CtaEssai />
</Base>
